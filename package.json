{
  "name": "anas",
  "type": "module",
  "version": "0.2.1",
  "private": true,
  "description": "A NAS — Storage management GUI for Proxmox",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n daemon,gateway -c blue,green \"ANASD_SOCKET=/tmp/anasd.sock npm run dev:daemon\" \"ANASD_SOCKET=/tmp/anasd.sock ANAS_AUTH_PROVIDER=dev ANAS_PORT=3100 npm run dev:gateway\"",
    "dev:daemon": "cd packages/daemon && tsx watch src/index.ts -- --mock",
    "dev:gateway": "cd packages/gateway && tsx watch src/index.ts",
    "build": "npm run build:shared && npm run build:daemon && npm run build:gateway",
    "build:shared": "cd packages/shared && tsc",
    "build:daemon": "cd packages/daemon && tsc",
    "build:gateway": "cd packages/gateway && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version:bump": "node packaging/bump-version.mjs",
    "typecheck": "npm run typecheck:shared && npm run typecheck:daemon && npm run typecheck:gateway",
    "typecheck:shared": "cd packages/shared && npx tsc --noEmit",
    "typecheck:daemon": "cd packages/daemon && npx tsc --noEmit",
    "typecheck:gateway": "cd packages/gateway && npx tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run test:unit:daemon && npm run test:unit:gateway",
    "test:unit:daemon": "cd packages/daemon && npm test",
    "test:unit:gateway": "cd packages/gateway && npm test",
    "test:integration": "npx playwright test --project=integration",
    "test:stunt-deploy": "./test/stunt-node/deploy-anas.sh",
    "test:stunt-run": "./test/stunt-node/run-tests.sh"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.2",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "typescript": "^5.9.3"
  }
}
